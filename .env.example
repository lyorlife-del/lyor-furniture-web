NODE_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql://lyor:lyor_local_only@127.0.0.1:5432/lyor?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000/api/v1
QUOTE_SECRET=local-demo-change-before-sharing-at-least-32-characters
# Opt-in database-backed PIN dialog. Requires FastAPI and an activated reference.
LOCATION_SERVICEABILITY_ENABLED=false
# FastAPI process settings; configure LYOR_DATABASE_URL etc. separately.
LYOR_SERVICEABILITY_MODE=disabled
LYOR_SERVICEABILITY_COMPANY_ID=lyor-demo
LOCATION_DETECTION_ENABLED=false
LOCATION_CATALOGUE_ENABLED=false
LYOR_GEOCODING_PROVIDER=disabled
LYOR_GEOCODING_LIVE_ENABLED=false
# Inject LYOR_GOOGLE_GEOCODING_API_KEY and LYOR_GEOCODING_REDIS_URL into the API process only.
LYOR_GEOCODING_DAILY_LIMIT=100
LYOR_GEOCODING_MINUTE_LIMIT=5
